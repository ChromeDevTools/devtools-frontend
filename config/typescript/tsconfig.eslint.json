{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "ES2024.Promise",
      "ESNext.Iterator",
      "ESNext.Collection",
      "ESNext.Array",
      "dom",
      "dom.iterable",
      "webworker",
      "webworker.iterable"
    ],
    "noEmit": true
  },
  "include": [
    "../../front_end/**/*.ts",
    "../../mcp/**/*.ts",
    "../../inspector_overlay/**/*.ts",
    "../../scripts/**/*.ts",
    "../../test/**/*.ts",
    "../../extensions/**/*.ts",
    "../../extension-api/**/*.ts"
  ],
  "exclude": [
    "../../front_end/third_party/**",
    "../../extensions/cxx_debugging/third_party/**",
    "../../node_modules/**",
    "../../out/**",
    "../../build/**",
    "../../buildtools/**",
    "../../release/**"
  ]
}
