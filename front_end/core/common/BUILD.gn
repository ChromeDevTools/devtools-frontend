import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")

ts_library("ColorUtils") {
  split_compilation = true
  sources = [ "ColorUtils.ts" ]
}

devtools_module("common") {
  split_compilation = true
  sources = [
    "Base64.ts",
    "CharacterIdMap.ts",
    "Color.ts",
    "ColorConverter.ts",
    "Console.ts",
    "Debouncer.ts",
    "EventTarget.ts",
    "Gzip.ts",
    "JavaScriptMetaData.ts",
    "Lazy.ts",
    "MapWithDefault.ts",
    "Mutex.ts",
    "Object.ts",
    "ParsedURL.ts",
    "Progress.ts",
    "ResolverBase.ts",
    "ResourceType.ts",
    "ReturnToPanel.ts",
    "Revealer.ts",
    "Runnable.ts",
    "SegmentedRange.ts",
    "SettingRegistration.ts",
    "Settings.ts",
    "SimpleHistoryManager.ts",
    "Srcset.ts",
    "StringOutputStream.ts",
    "TextDictionary.ts",
    "Throttler.ts",
    "Trie.ts",
    "VersionController.ts",
  ]

  ts_deps = [
    ":ColorUtils",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "common.ts"

  ts_deps = [
    ":ColorUtils",
    ":common",
    "../platform:bundle",
  ]

  visibility = [ "*" ]
}

devtools_foundation_module("foundation_unittests") {
  testonly = true
  split_compilation = true

  sources = [
    "Base64.test.ts",
    "CharacterIdMap.test.ts",
    "Color.test.ts",
    "ColorConverter.test.ts",
    "ColorUtils.test.ts",
    "Console.test.ts",
    "Debouncer.test.ts",
    "EventTarget.test.ts",
    "Gzip.test.ts",
    "Lazy.test.ts",
    "MapWithDefault.test.ts",
    "Mutex.test.ts",
    "Object.test.ts",
    "ParsedURL.test.ts",
    "Progress.test.ts",
    "ResolverBase.test.ts",
    "ResourceType.test.ts",
    "Revealer.test.ts",
    "SegmentedRange.test.ts",
    "SettingRegistration.test.ts",
    "Settings.test.ts",
    "SimpleHistoryManager.test.ts",
    "Srcset.test.ts",
    "StringOutputStream.test.ts",
    "TextDictionary.test.ts",
    "Throttler.test.ts",
    "Trie.test.ts",
    "VersionController.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../testing",
    "../platform:bundle",
    "../root:bundle",
  ]
}
