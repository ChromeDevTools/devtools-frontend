import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")

devtools_foundation_module("host_base") {
  sources = [
    "InspectorFrontendHostAPI.ts",
    "ResourceLoader.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
  ]

  additional_type_definitions =
      [ "../../../node_modules/@types/filesystem/index.d.ts" ]
}

ts_library("host_stub") {
  sources = [ "InspectorFrontendHostStub.ts" ]

  ts_deps = [
    ":host_base",
    "../../core/common:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
  ]
}

devtools_foundation_module("host") {
  sources = [
    "AidaClient.ts",
    "AidaClientTypes.ts",
    "AidaGcaTranslation.ts",
    "DispatchHttpRequestClient.ts",
    "GcaClient.ts",
    "GcaTypes.ts",
    "GdpClient.ts",
    "InspectorFrontendHost.ts",
    "Platform.ts",
    "UserMetrics.ts",
    "UserMetricsEnums.ts",
  ]

  ts_deps = [
    ":host_base",
    ":host_stub",
    "../../core/common:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "host.ts"

  ts_deps = [
    ":host",
    ":host_base",
    ":host_stub",
  ]

  visibility = [ "*" ]
}

devtools_foundation_module("foundation_unittests") {
  testonly = true

  sources = [
    "AidaClient.test.ts",
    "AidaGcaTranslation.test.ts",
    "DispatchHttpRequestClient.test.ts",
    "GcaClient.test.ts",
    "GdpClient.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../testing",
    "../common:bundle",
    "../platform:bundle",
    "../root:bundle",
  ]
}
