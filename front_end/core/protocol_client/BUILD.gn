import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")

devtools_foundation_module("protocol_client") {
  sources = [
    "CDPConnection.ts",
    "ConnectionTransport.ts",
    "DevToolsCDPConnection.ts",
    "InspectorBackend.ts",
  ]

  deps = [
    "../../generated",
    "../../generated:protocol",
    "../platform:bundle",
  ]
}

# TODO: We keep PuppeteerDevToolsConnection in a separate target because node
# types will leak into the rest of DevTools compilation otherwise!
devtools_foundation_module("puppeteer_devtools_connection") {
  sources = [ "PuppeteerDevToolsConnection.ts" ]

  deps = [
    ":protocol_client",
    "../../third_party/puppeteer:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "protocol_client.ts"

  deps = [
    ":protocol_client",
    "../../generated",
  ]

  visibility = [ "*" ]
}

devtools_foundation_module("unittests") {
  testonly = true

  sources = [
    "InspectorBackend.test.ts",
    "PuppeteerDevToolsConnection.test.ts",
  ]

  deps = [
    ":bundle",
    ":puppeteer_devtools_connection",
    "../../generated:protocol",
    "../../testing",
    "../../third_party/puppeteer:bundle",
  ]
}
