import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/devtools_worker.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

devtools_foundation_module("heap_snapshot_worker") {
  split_compilation = true
  sources = [
    "AllocationProfile.ts",
    "HeapSnapshot.ts",
    "HeapSnapshotLoader.ts",
    "HeapSnapshotWorkerDispatcher.ts",
  ]

  ts_deps = [
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/platform/api:bundle",
    "../../core/text_utils:bundle",
    "../../models/heap_snapshot:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "heap_snapshot_worker.ts"

  ts_deps = [ ":heap_snapshot_worker" ]

  visibility = [ ":*" ]

  visibility += devtools_entrypoints_visibility
}

devtools_entrypoint("worker_entrypoint") {
  split_compilation = true
  entrypoint = "heap_snapshot_worker-entrypoint.ts"

  forward_variables_from(devtools_worker_config, "*")

  ts_deps = [
    ":bundle",
    "../../core/platform:bundle",
  ]

  visibility = [
    ":*",
    "../../../front_end",
  ]

  visibility += devtools_entrypoints_visibility
}

devtools_foundation_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [
    "HeapSnapshot.test.ts",
    "heap_snapshot_worker.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../models/heap_snapshot:bundle",
  ]
}
