import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

devtools_foundation_module("ai-utils") {
  sources = [
    "AiHistoryStorage.ts",
    "AiSetting.ts",
    "AiUtils.ts",
    "debug.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
  ]
}

# BuiltInAi.ts interacts with browser-only APIs (window.LanguageModel and canvas
# WebGL GPU detection). It is isolated in a separate ts_library so DOM/window
# types do not leak into the rest of models/ai-utils.
ts_library("built_in_ai") {
  sources = [ "BuiltInAi.ts" ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/root:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "ai-utils.ts"

  ts_deps = [
    ":ai-utils",
    ":built_in_ai",
  ]

  visibility = [
    ":*",
    "../../entrypoints/main/*",
    "../../foundation/*",
    "../../panels/ai_assistance/*",
    "../../panels/application/*",
    "../../panels/common/*",
    "../../panels/console/*",
    "../../panels/elements/*",
    "../../panels/explain/*",
    "../../panels/network/*",
    "../../panels/settings/*",
    "../../panels/sources/*",
    "../../panels/timeline/*",
    "../../testing/*",
    "../../ui/components/text_editor/*",
    "../ai_assistance/*",
    "../ai_code_completion",
  ]

  visibility += devtools_models_visibility
}

ts_library("unittests") {
  testonly = true

  sources = [ "BuiltInAi.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../testing",
  ]
}

devtools_foundation_module("foundation_unittests") {
  testonly = true

  sources = [
    "AiSetting.test.ts",
    "AiUtils.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../testing",
  ]
}
