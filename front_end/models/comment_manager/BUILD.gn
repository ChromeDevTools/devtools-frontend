import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

devtools_foundation_module("comment_manager") {
  sources = [
    "CD4ABridge.ts",
    "CommentManager.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/root:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../logs:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "comment_manager.ts"

  ts_deps = [ ":comment_manager" ]

  visibility = [
    ":*",
    "../../entrypoints/main/*",
    "../../foundation/*",
    "../../testing/*",
    "../../ui/comments/*",
  ]

  visibility += devtools_models_visibility
}

devtools_foundation_module("foundation_unittests") {
  testonly = true

  sources = [
    "CD4ABridge.test.ts",
    "CommentManager.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/root:bundle",
    "../../core/sdk:bundle",
    "../../testing",
    "../logs:bundle",
  ]
}
