import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")

devtools_module("computed_style") {
  sources = [ "ComputedStyleModel.ts" ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/sdk:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "computed_style.ts"

  ts_deps = [ ":computed_style" ]

  visibility = [
    ":*",
    "../../panels/ai_assistance/*",
    "../../panels/elements/*",
    "../ai_assistance/*",
  ]
}

ts_library("unittests") {
  testonly = true

  sources = [ "ComputedStyleModel.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../testing",
  ]
}
