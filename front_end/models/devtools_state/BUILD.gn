import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../visibility.gni")

devtools_foundation_module("devtools_state") {
  sources = [
    "State.ts",
    "StateManager.ts",
    "providers/CPUThrottlingStateProvider.ts",
    "providers/NetworkStateProvider.ts",
    "providers/SettingsStateProvider.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/sdk:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "devtools_state.ts"

  ts_deps = [ ":devtools_state" ]

  visibility = [
    ":*",
    "../../foundation/*",
    "../../panels/common/*",
    "../../testing/*",
  ]

  visibility += devtools_models_visibility
}

devtools_foundation_module("foundation_unittests") {
  testonly = true

  sources = [
    "StateManager.test.ts",
    "providers/CPUThrottlingStateProvider.test.ts",
    "providers/NetworkStateProvider.test.ts",
    "providers/SettingsStateProvider.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/sdk:bundle",
    "../../testing",
  ]
}
