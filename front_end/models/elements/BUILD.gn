import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

devtools_foundation_module("elements") {
  sources = [
    "DOMChanges.ts",
    "ElementUpdateRecord.ts",
  ]

  ts_deps = [
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../change_tracker:bundle",
    "../comment_manager:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "elements.ts"

  ts_deps = [ ":elements" ]

  visibility = [
    ":*",
    "../*",
    "../../foundation/*",
    "../../panels/elements/*",
    "../../testing/*",
  ]

  visibility += devtools_models_visibility
}

devtools_foundation_module("foundation_unittests") {
  testonly = true

  sources = [ "DOMChanges.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../core/sdk:bundle",
    "../../testing",
    "../change_tracker:bundle",
    "../comment_manager:bundle",
  ]
}
