import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

devtools_foundation_module("extensions") {
  sources = [
    "ExtensionEndpoint.ts",
    "HostUrlPattern.ts",
    "LanguageExtensionEndpoint.ts",
    "RecorderExtensionEndpoint.ts",
    "RecorderPluginManager.ts",
  ]

  ts_deps = [
    ":extension_api",
    "../../../extension-api",
    "../../core/common:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
    "../../core/sdk:bundle",
    "../../models/bindings:bundle",
  ]
}

# ExtensionAPI.ts contains the extension API implementation that is
# serialized via .toString() and injected into the extension's iframe/window. It
# runs in a browser DOM environment and requires DOM/window types, isolated in a
# separate ts_library so DOM types do not leak into the rest of
# models/extensions.
ts_library("extension_api") {
  sources = [ "ExtensionAPI.ts" ]

  ts_deps = [
    "../../../extension-api",
    "../../core/platform:bundle",
    "../../models/har:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "extensions.ts"

  ts_deps = [
    ":extension_api",
    ":extensions",
  ]

  visibility = [
    ":*",
    "../../entrypoints/main/*",
    "../../panels/common/*",
    "../../panels/elements/*",
    "../../panels/recorder/*",
    "../../panels/sources/*",
    "../../panels/timeline/*",
    "../../testing/*",
  ]

  visibility += devtools_models_visibility
}

devtools_foundation_module("foundation_unittests") {
  testonly = true

  sources = [
    "HostUrlPattern.test.ts",
    "LanguageExtensionEndpoint.test.ts",
    "RecorderPluginManager.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../testing",
    "../bindings:bundle",
  ]
}
