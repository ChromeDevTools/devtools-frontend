{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": true,
    "composite": false,
    "declaration": false,
    "disableSourceOfProjectReferenceRedirect": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": false,
    "inlineSources": true,
    "lib": [
      "ES2023",
      "ES2024.Promise",
      "ESNext.Iterator",
      "ESNext.Collection",
      "ESNext.Array"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "outDir": ".",
    "preserveConstEnums": true,
    "rootDir": "../../../../../../front_end/models/formatter",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2023",
    "typeRoots": [
      "../../../../../../node_modules/@types",
      "../../../../../../node_modules"
    ],
    "types": [
      "mocha",
      "node",
      "undici-types"
    ],
    "useUnknownInCatchVariables": false
  },
  "files": [
    "../../../../../../front_end/models/formatter/FormatterWorkerPool.test.ts",
    "../../../../../../front_end/models/formatter/ScriptFormatter.test.ts"
  ],
  "references": [
    {
      "path": "bundle-tsconfig.ref.json"
    },
    {
      "path": "../../core/common/bundle-tsconfig.ref.json"
    }
  ]
}