import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")

devtools_foundation_module("har") {
  sources = [
    "HARFormat.ts",
    "Importer.ts",
    "Log.ts",
    "Writer.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../core/text_utils:bundle",
    "../../generated",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "har.ts"

  ts_deps = [ ":har" ]

  visibility = [
    ":*",
    "../../panels/common/*",
    "../../panels/network/*",
    "../extensions/*",
  ]
}

devtools_foundation_module("unittests") {
  testonly = true

  sources = [
    "Importer.test.ts",
    "Log.test.ts",
    "Writer.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../core/text_utils:bundle",
    "../../generated",
    "../../testing",
  ]
}
