import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")

devtools_module("live-metrics") {
  split_compilation = true
  sources = [ "LiveMetrics.ts" ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../crux-manager:bundle",
    "../emulation:bundle",
    "./web-vitals-injected/spec:bundle",
  ]

  public_deps = [
    "./web-vitals-injected",
    "./web-vitals-injected:bundled_library",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "live-metrics.ts"

  ts_deps = [ ":live-metrics" ]

  visibility = [
    ":*",
    "../../entrypoints/main/*",
    "../../foundation/*",
    "../../panels/timeline/*",
    "../../testing/*",
  ]
}

ts_library("unittests") {
  split_compilation = true
  testonly = true

  sources = [ "LiveMetrics.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../testing",
    "../trace:bundle",
    "web-vitals-injected/spec:bundle",
  ]
}
