import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

devtools_module("persistence") {
  sources = [
    "Automapping.ts",
    "AutomaticFileSystemManager.ts",
    "AutomaticFileSystemWorkspaceBinding.ts",
    "FileSystemWorkspaceBinding.ts",
    "IsolatedFileSystem.ts",
    "IsolatedFileSystemManager.ts",
    "NetworkPersistenceManager.ts",
    "PersistenceImpl.ts",
    "PlatformFileSystem.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
    "../../core/sdk:bundle",
    "../../core/text_utils:bundle",
    "../../generated",
    "../../models/bindings:bundle",
    "../../models/breakpoints:bundle",
    "../../models/project_settings:bundle",
    "../../models/workspace:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "persistence.ts"

  ts_deps = [ ":persistence" ]

  visibility = [
    ":*",
    "../../core/sdk/*",
    "../../entrypoints/main/*",
    "../../foundation/*",
    "../../models/ai_assistance/*",
    "../../panels/ai_assistance/*",
    "../../panels/changes/*",
    "../../panels/common/*",
    "../../panels/network/*",
    "../../panels/recorder/*",
    "../../panels/settings/*",
    "../../panels/snippets/*",
    "../../panels/sources/*",
    "../../panels/utils/*",
    "../../testing/*",
    "../bindings:*",
    "../breakpoints/*",
    "../workspace:*",
    "../workspace_diff/*",
  ]

  visibility += devtools_models_visibility
}

ts_library("unittests") {
  testonly = true

  sources = [
    "Automapping.test.ts",
    "AutomaticFileSystemManager.test.ts",
    "AutomaticFileSystemWorkspaceBinding.test.ts",
    "FileSystemWorkspaceBinding.test.ts",
    "IsolatedFileSystemManager.test.ts",
    "NetworkPersistenceManager.test.ts",
    "PersistenceImpl.test.ts",
    "PlatformFileSystem.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../core/text_utils:bundle",
    "../../generated",
    "../../testing",
    "../breakpoints:bundle",
    "../project_settings:bundle",
    "../workspace:bundle",
  ]
}
