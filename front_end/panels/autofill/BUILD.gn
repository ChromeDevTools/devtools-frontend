import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [ "autofillView.css" ]
}

devtools_ui_module("autofill") {
  split_compilation = true
  sources = [ "AutofillView.ts" ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../models/autofill_manager:bundle",
    "../../ui/components/adorners:bundle",
    "../../ui/kit:bundle",
    "../../ui/legacy:bundle",
    "../../ui/legacy/components/data_grid:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "autofill.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":autofill" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  split_compilation = true
  entrypoint = "autofill-meta.ts"

  ts_deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [ "../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [ "AutofillView.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../generated",
    "../../models/autofill_manager:bundle",
    "../../testing",
    "../../ui/legacy:bundle",
  ]
}
