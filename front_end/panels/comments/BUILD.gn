import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [ "commentsPane.css" ]
}

devtools_ui_module("comments") {
  sources = [ "CommentsPane.ts" ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/i18n:bundle",
    "../../models/comment_manager:bundle",
    "../../ui/components/buttons:bundle",
    "../../ui/components/tooltips:bundle",
    "../../ui/legacy:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
    "../common:bundle",
  ]
  deps = [ ":css_files" ]
}

devtools_entrypoint("bundle") {
  entrypoint = "comments.ts"

  ts_deps = [ ":comments" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "comments-meta.ts"

  ts_deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [ "../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [ "CommentsPane.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../models/comment_manager:bundle",
    "../../testing",
  ]
}
