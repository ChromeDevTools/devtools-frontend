generate_css("css_files") {
  sources = [
    "aiCodeCompletionSummaryToolbar.css",
    "badgeNotification.css",
    "domLinkifier.css",
    "gdpSignUpDialog.css",
    "geminiRebrandPromoDialog.css",
  ]
}

devtools_ui_module("common") {
  sources = [
    "AiCodeCompletionSummaryToolbar.ts",
    "BadgeNotification.ts",
    "CPUThrottlingOption.ts",
    "DOMLinkifier.ts",
    "ExtensionPanel.ts",
    "ExtensionServer.ts",
    "ExtensionView.ts",
    "GdpSignUpDialog.ts",
    "GeminiRebrandPromoDialog.ts",
    "PersistenceUtils.ts",
  ]

  deps = [
    "../../../extension-api",
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/protocol_client:bundle",
    "../../core/root:bundle",
    "../../core/sdk:bundle",
    "../../core/text_utils:bundle",
    "../../generated",
    "../../models/badges:bundle",
    "../../models/bindings:bundle",
    "../../models/extensions:bundle",
    "../../models/geometry:bundle",
    "../../models/har:bundle",
    "../../models/logs:bundle",
    "../../models/persistence:bundle",
    "../../models/workspace:bundle",
    "../../ui/components/buttons:bundle",
    "../../ui/components/snackbars:bundle",
    "../../ui/components/spinners:bundle",
    "../../ui/components/switch:bundle",
    "../../ui/components/text_editor:bundle",
    "../../ui/components/tooltips:bundle",
    "../../ui/helpers:bundle",
    "../../ui/i18n:bundle",
    "../../ui/kit:bundle",
    "../../ui/legacy:bundle",
    "../../ui/legacy/components/object_ui:bundle",
    "../../ui/legacy/components/utils:bundle",
    "../../ui/legacy/theme_support:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "common.ts"

  deps = [
    ":common",
    ":css_files",
  ]

  visibility = [
    "../*",
    "../../entrypoints/main",
    "../../testing",
  ]

  visibility += devtools_panels_visibility
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [
    "AiCodeCompletionSummaryToolbar.test.ts",
    "BadgeNotification.test.ts",
    "DOMLinkifier.test.ts",
    "ExtensionPanel.test.ts",
    "ExtensionServer.test.ts",
    "GdpSignUpDialog.test.ts",
  ]

  deps = [
    ":bundle",
    "../../../extension-api",
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
    "../../core/sdk:bundle",
    "../../core/text_utils:bundle",
    "../../generated",
    "../../models/ai_code_completion:bundle",
    "../../models/badges:bundle",
    "../../models/bindings:bundle",
    "../../models/crux-manager:bundle",
    "../../models/extensions:bundle",
    "../../models/har:bundle",
    "../../models/logs:bundle",
    "../../models/workspace:bundle",
    "../../testing",
    "../../ui/components/snackbars:bundle",
