import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [
    "coverageListView.css",
    "coverageView.css",
  ]
}

devtools_ui_module("coverage") {
  split_compilation = true
  sources = [
    "CoverageDecorationManager.ts",
    "CoverageListView.ts",
    "CoverageModel.ts",
    "CoverageView.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../core/text_utils:bundle",
    "../../generated",
    "../../models/bindings:bundle",
    "../../models/workspace:bundle",
    "../../ui/components/buttons:bundle",
    "../../ui/components/highlighting:bundle",
    "../../ui/legacy:bundle",
    "../../ui/legacy/components/data_grid:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "coverage.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":coverage" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
    "../sources/*",
    "../timeline/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  split_compilation = true
  entrypoint = "coverage-meta.ts"

  ts_deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [ "../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [
    "CoverageDecorationManager.test.ts",
    "CoverageListView.test.ts",
    "CoverageModel.test.ts",
    "CoverageView.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../core/text_utils:bundle",
    "../../generated",
    "../../models/bindings:bundle",
    "../../models/formatter:bundle",
    "../../models/workspace:bundle",
    "../../testing",
    "../../ui/components/render_coordinator:bundle",
    "../../ui/legacy:bundle",
  ]
}
