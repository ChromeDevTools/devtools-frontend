import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [ "eventListenersView.css" ]
}

devtools_ui_module("event_listeners") {
  split_compilation = true
  sources = [
    "EventListenersUtils.ts",
    "EventListenersView.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../ui/components/buttons:bundle",
    "../../ui/legacy:bundle",
    "../../ui/legacy/components/object_ui:bundle",
    "../../ui/legacy/components/utils:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "event_listeners.ts"

  deps = [
    ":css_files",
    "../../ui/legacy/components/object_ui:css_files",
  ]

  ts_deps = [ ":event_listeners" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
    "../../legacy_test_runner/*",
    "../browser_debugger/*",
    "../elements/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [ "EventListenersView.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../testing",
  ]
}
