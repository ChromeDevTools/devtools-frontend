import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [
    "eventDisplayTable.css",
    "playerListView.css",
    "playerMessagesView.css",
    "playerPropertiesView.css",
  ]
}

devtools_ui_module("media") {
  split_compilation = true
  sources = [
    "EventDisplayTable.ts",
    "EventTimelineView.ts",
    "MainView.ts",
    "MediaModel.ts",
    "PlayerDetailView.ts",
    "PlayerListView.ts",
    "PlayerMessagesView.ts",
    "PlayerPropertiesView.ts",
    "TickingFlameChart.ts",
    "TickingFlameChartHelpers.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../ui/kit:bundle",
    "../../ui/legacy:bundle",
    "../../ui/legacy/components/data_grid:bundle",
    "../../ui/legacy/components/perf_ui:bundle",
    "../../ui/legacy/components/source_frame:bundle",
    "../../ui/legacy/theme_support:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "media.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":media" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
    "../../panels/elements/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  split_compilation = true
  entrypoint = "media-meta.ts"

  ts_deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [ "../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [
    "EventDisplayTable.test.ts",
    "MainView.test.ts",
    "PlayerListView.test.ts",
    "PlayerMessagesView.test.ts",
    "PlayerPropertiesView.test.ts",
    "TickingFlameChartHelpers.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../testing",
    "../../ui/components/render_coordinator:bundle",
  ]
}
