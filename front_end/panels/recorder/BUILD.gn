import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")

generate_css("css_files") {
  sources = [
    "controlButton.css",
    "createRecordingView.css",
    "extensionView.css",
    "recorderPanel.css",
    "recordingListView.css",
    "recordingView.css",
    "replaySection.css",
    "selectorPicker.css",
    "stepEditor.css",
    "stepView.css",
    "timelineSection.css",
  ]
}

devtools_ui_module("recorder") {
  sources = [
    "ControlButton.ts",
    "CreateRecordingView.ts",
    "ExtensionView.ts",
    "RecorderEvents.ts",
    "RecorderPanel.ts",
    "RecordingListView.ts",
    "RecordingView.ts",
    "ReplaySection.ts",
    "SelectorPicker.ts",
    "StepEditor.ts",
    "StepView.ts",
    "TimelineSection.ts",
  ]

  deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/root:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../models/badges:bundle",
    "../../models/bindings:bundle",
    "../../models/emulation:bundle",
    "../../models/extensions:bundle",
    "../../models/trace:bundle",
    "../../services/tracing:bundle",
    "../../third_party/codemirror.next:bundle",
    "../../third_party/puppeteer:bundle",
    "../../third_party/puppeteer-replay:bundle",
    "../../ui/components/buttons:bundle",
    "../../ui/components/code_highlighter:bundle",
    "../../ui/components/dialogs:bundle",
    "../../ui/components/input:bundle",
    "../../ui/components/menus:bundle",
    "../../ui/components/suggestion_input:bundle",
    "../../ui/components/text_editor:bundle",
    "../../ui/kit:bundle",
    "../../ui/legacy:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
    "./converters:bundle",
    "./extensions:bundle",
    "./models:bundle",
    "./models:recorder",
    "./recorder-actions:bundle",
    "./util:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "recorder.ts"

  deps = [
    ":css_files",
    ":recorder",
  ]

  visibility = [
    ":*",
    "../../../test/e2e/helpers:*",
    "../../../test/e2e/recorder:*",
    "../../entrypoints/main/*",
    "../../panels/sources/*",
    "../../ui/components/docs/*",
  ]
}

devtools_entrypoint("meta") {
  entrypoint = "recorder-meta.ts"

  deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
    "./recorder-actions:bundle",
  ]

  visibility = [
    "../..:*",
    "../../entrypoints/devtools_app:*",
    "../../entrypoints/inspector:*",
  ]
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [
    "CreateRecordingView.test.ts",
    "RecorderPanel.test.ts",
    "RecordingListView.test.ts",
    "RecordingView.test.ts",
    "ReplaySection.test.ts",
    "StepEditor.test.ts",
    "StepView.test.ts",
    "injected.test.ts",
  ]

  deps = [
    ":bundle",
    "../../core/host:bundle",
    "../../testing",
    "../../ui/components/menus:bundle",
    "../../ui/components/suggestion_input:bundle",
    "../../ui/legacy:bundle",
    "./converters:bundle",
    "./extensions:bundle",
    "./models:bundle",
    "./recorder-actions:bundle",
    "./testing",
    "injected:bundle",
  ]
}
