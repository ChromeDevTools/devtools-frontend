import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [
    "lockIcon.css",
    "mainView.css",
    "originView.css",
    "sidebar.css",
  ]
}

devtools_ui_module("security") {
  split_compilation = true
  sources = [
    "SecurityModel.ts",
    "SecurityPanel.ts",
    "SecurityPanelSidebar.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../panels/network/forward:bundle",
    "../../ui/components/buttons:bundle",
    "../../ui/kit:bundle",
    "../../ui/legacy:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "security.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":security" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  split_compilation = true
  entrypoint = "security-meta.ts"

  ts_deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [ "../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [
    "SecurityModel.test.ts",
    "SecurityPanel.test.ts",
    "SecurityPanelSidebar.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../testing",
  ]
}
