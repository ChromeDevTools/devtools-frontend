import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [
    "locationsSettingsTab.css",
    "sensors.css",
  ]
}

devtools_ui_module("sensors") {
  split_compilation = true
  sources = [
    "LocationsSettingsTab.ts",
    "SensorsView.ts",
  ]

  ts_deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/sdk:bundle",
    "../../models/geometry:bundle",
    "../../panels/mobile_throttling:bundle",
    "../../ui/components/buttons:bundle",
    "../../ui/components/lists:bundle",
    "../../ui/kit:bundle",
    "../../ui/legacy:bundle",
    "../../ui/legacy/components/settings_ui:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "sensors.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":sensors" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  split_compilation = true
  entrypoint = "sensors-meta.ts"

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/i18n:bundle",
    "../../core/sdk:bundle",
    "../../ui/legacy:bundle",
    "../../ui/settings:bundle",
  ]

  visibility = [
    ":*",
    "../../entrypoints/*",
    "../../panels/greendev/*",
    "../../testing/*",
  ]
}

ts_library("unittests") {
  split_compilation = true
  testonly = true

  sources = [
    "LocationsSettingsTab.test.ts",
    "SensorsView.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../testing",
    "../../ui/components/render_coordinator:bundle",
    "../../ui/legacy:bundle",
    "../../ui/lit:bundle",
  ]
}
