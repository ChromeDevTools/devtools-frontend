import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../visibility.gni")

generate_css("css_files") {
  sources = [ "devicesSettingsTab.css" ]
}

devtools_ui_module("emulation") {
  sources = [ "DevicesSettingsTab.ts" ]

  ts_deps = [
    "../../../core/i18n:bundle",
    "../../../core/root:bundle",
    "../../../models/emulation:bundle",
    "../../../ui/components/buttons:bundle",
    "../../../ui/kit:bundle",
    "../../../ui/legacy:bundle",
    "../../../ui/visual_logging:bundle",
    "./components:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "emulation.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":emulation" ]

  visibility = [
    ":*",
    "../../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "emulation-meta.ts"

  ts_deps = [
    ":bundle",
    "../../../core/i18n:bundle",
    "../../../ui/legacy:bundle",
  ]

  visibility = [
    "../*",
    "../../../entrypoints/*",
  ]
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [ "DevicesSettingsTab.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../../models/emulation:bundle",
    "../../../testing",
    "../../../ui/legacy:bundle",
  ]
}
