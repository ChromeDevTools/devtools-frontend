import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../visibility.gni")

generate_css("css_files") {
  sources = [ "commentsOverlay.css" ]
}

devtools_ui_module("comments") {
  sources = [
    "CommentAnchorResolver.ts",
    "CommentOverlayManager.ts",
    "CommentsOverlayWidget.ts",
  ]

  deps = [
    "../../core/common:bundle",
    "../../core/root:bundle",
    "../../models/comment_manager:bundle",
    "../../third_party/codemirror.next:bundle",
    "../../ui/legacy:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "comments.ts"

  deps = [
    ":comments",
    ":css_files",
  ]

  visibility = [
    ":*",
    "../../entrypoints/main/*",
    "../../panels/*",
    "../../testing/*",
    "../components/*",
    "../legacy/*",
  ]

  visibility += devtools_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "comments-meta.ts"

  deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../core/root:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [ "../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [
    "CommentAnchorResolver.test.ts",
    "CommentOverlayManager.test.ts",
    "CommentsOverlayWidget.test.ts",
  ]

  deps = [
    ":bundle",
    "../../models/comment_manager:bundle",
    "../../testing",
    "../../third_party/codemirror.next:bundle",
    "../../ui/legacy:bundle",
    "../components/text_editor:bundle",
  ]
}
