import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/devtools_pre_built.gni")
import("../../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

devtools_ui_module("helpers") {
  split_compilation = true
  sources = [
    "component-server-setup.ts",
    "get-root-node.ts",
    "scheduled-render.ts",
  ]

  ts_deps = [
    "../../../core/common:bundle",
    "../../../ui/legacy/theme_support:bundle",
    "../render_coordinator:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "helpers.ts"

  ts_deps = [ ":helpers" ]

  visibility = [
    "../../../testing/*",
    "../../legacy/*",
    "../../legacy/components/inline_editor/*",
  ]

  visibility += default_components_visibility
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [ "helpers.test.ts" ]

  ts_deps = [
    ":bundle",
    "../render_coordinator:bundle",
  ]
}
