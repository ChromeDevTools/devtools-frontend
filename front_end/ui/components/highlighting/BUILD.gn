import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

devtools_ui_module("highlighting") {
  split_compilation = true
  sources = [
    "HighlightElement.ts",
    "HighlightManager.ts",
    "MarkupHighlight.ts",
  ]
  ts_deps = [ "../../../core/text_utils:bundle" ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "highlighting.ts"

  ts_deps = [ ":highlighting" ]

  visibility = default_components_visibility
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [
    "HighlightElement.test.ts",
    "HighlightManager.test.ts",
    "MarkupHighlight.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../../core/text_utils:bundle",
    "../../../testing",
  ]
}
