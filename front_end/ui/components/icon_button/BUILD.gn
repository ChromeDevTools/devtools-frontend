import("../../../../scripts/build/ninja/component_doc.gni")
import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [
    "fileSourceIcon.css",
    "iconButton.css",
  ]
}

devtools_ui_module("icon_button") {
  split_compilation = true
  sources = [
    "FileSourceIcon.ts",
    "IconButton.ts",
  ]

  deps = [ "../../../Images:optimize_images" ]

  ts_deps = [
    "../../kit:bundle",
    "../../lit:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "icon_button.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":icon_button" ]

  visibility = [
    "../../../entrypoints/inspector_main/*",
    "../../../entrypoints/main/*",
    "../../../panels/utils/*",
    "../../legacy/*",
    "../../legacy/components/color_picker/*",
    "../../legacy/components/object_ui/*",
  ]

  visibility += default_components_visibility
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [
    "FileSourceIcon.test.ts",
    "IconButton.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../../testing",
    "../../kit:bundle",
  ]
}
