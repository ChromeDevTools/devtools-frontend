import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [
    "issueCounter.css",
    "issueLinkIcon.css",
  ]
}

devtools_ui_module("issue_counter") {
  sources = [
    "IssueCounter.ts",
    "IssueLinkIcon.ts",
  ]

  ts_deps = [
    "../../../core/common:bundle",
    "../../../core/i18n:bundle",
    "../../../core/platform:bundle",
    "../../../generated",
    "../../../models/issues_manager:bundle",
    "../../kit:bundle",
    "../../lit:bundle",
    "../../visual_logging:bundle",
    "../icon_button:bundle",
    "../render_coordinator:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "issue_counter.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":issue_counter" ]

  visibility = default_components_visibility
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [
    "IssueCounter.test.ts",
    "IssueLinkIcon.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../../core/common:bundle",
    "../../../generated",
    "../../../models/issues_manager:bundle",
    "../../../testing",
    "../../kit:bundle",
    "../icon_button:bundle",
    "../render_coordinator:bundle",
  ]
}
