import("../../../../scripts/build/ninja/component_doc.gni")
import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [
    "codeBlock.css",
    "markdownImage.css",
    "markdownView.css",
  ]
}

devtools_ui_module("markdown_view") {
  split_compilation = true
  sources = [
    "CodeBlock.ts",
    "MarkdownImage.ts",
    "MarkdownImagesMap.ts",
    "MarkdownLinksMap.ts",
    "MarkdownView.ts",
  ]
  ts_deps = [
    "../../../core/i18n:bundle",
    "../../../third_party/codemirror.next:bundle",
    "../../../third_party/marked:bundle",
    "../../kit:bundle",
    "../../legacy:bundle",
    "../../lit:bundle",
    "../../visual_logging:bundle",
    "../buttons:bundle",
    "../text_editor:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "markdown_view.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":markdown_view" ]

  visibility = default_components_visibility
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [
    "CodeBlock.test.ts",
    "MarkdownImage.test.ts",
    "MarkdownView.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../../core/host:bundle",
    "../../../core/i18n:bundle",
    "../../../generated",
    "../../../models/issues_manager:bundle",
    "../../../testing",
    "../../../third_party/marked:bundle",
    "../../kit:bundle",
    "../../lit:bundle",
    "../render_coordinator:bundle",
    "../text_editor:bundle",
  ]

  data_deps = [ "../../../models/issues_manager:descriptions" ]
}

component_doc("docs") {
  sources = [ "MarkdownView.docs.ts" ]
  ts_deps = [
    ":bundle",
    "../../../third_party/marked:bundle",
    "../../lit:bundle",
  ]
}
