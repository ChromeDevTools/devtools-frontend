import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../../../scripts/build/typescript/typescript.gni")

generate_css("css_files") {
  sources = [
    "menu.css",
    "menuGroup.css",
    "menuItem.css",
    "selectMenu.css",
    "selectMenuButton.css",
  ]
}

devtools_ui_module("menus") {
  split_compilation = true
  sources = [
    "Menu.ts",
    "SelectMenu.ts",
  ]
  ts_deps = [
    "../../../core/platform:bundle",
    "../../lit:bundle",
    "../../visual_logging:bundle",
    "../dialogs:bundle",
    "../helpers:bundle",
    "../render_coordinator:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "menus.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":menus" ]

  visibility = [ "*" ]
}

devtools_ui_module("unittests") {
  split_compilation = true
  testonly = true

  sources = [ "SelectMenu.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../../testing",
    "../../lit:bundle",
    "../dialogs:bundle",
    "../render_coordinator:bundle",
  ]
}
