import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [
    "panelFeedback.css",
    "previewToggle.css",
  ]
}

devtools_ui_module("panel_feedback") {
  sources = [
    "FeedbackButton.ts",
    "PanelFeedback.ts",
    "PreviewToggle.ts",
  ]
  ts_deps = [
    "../../../core/host:bundle",
    "../../../core/i18n:bundle",
    "../../../core/platform:bundle",
    "../../../core/root:bundle",
    "../../kit:bundle",
    "../../legacy:bundle",
    "../../lit:bundle",
    "../buttons:bundle",
    "../helpers:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "panel_feedback.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":panel_feedback" ]

  visibility = default_components_visibility
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [
    "FeedbackButton.test.ts",
    "PanelFeedback.test.ts",
    "PreviewToggle.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../../core/host:bundle",
    "../../../core/platform:bundle",
    "../../../core/root:bundle",
    "../../../testing",
    "../render_coordinator:bundle",
  ]
}
