import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [ "settingCheckbox.css" ]
}

devtools_ui_module("settings") {
  sources = [ "SettingCheckbox.ts" ]

  ts_deps = [
    "../../../core/common:bundle",
    "../../../core/host:bundle",
    "../../../core/i18n:bundle",
    "../../kit:bundle",
    "../../lit:bundle",
    "../../settings:bundle",
    "../../visual_logging:bundle",
    "../buttons:bundle",
    "../input:bundle",
    "../tooltips:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "settings.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":settings" ]

  visibility = default_components_visibility + [ "../../legacy/*" ]
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [ "SettingCheckbox.test.ts" ]

  ts_deps = [
    ":bundle",
    "../../../core/root:bundle",
    "../../../testing",
  ]
}
