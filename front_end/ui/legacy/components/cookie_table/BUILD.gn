import("../../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../../scripts/build/ninja/generate_css.gni")
import("../../visibility.gni")

generate_css("css_files") {
  sources = [ "cookiesTable.css" ]
}

devtools_ui_module("cookie_table") {
  split_compilation = true
  sources = [ "CookiesTable.ts" ]

  ts_deps = [
    "../../../../core/common:bundle",
    "../../../../core/i18n:bundle",
    "../../../../core/root:bundle",
    "../../../../core/sdk:bundle",
    "../../../../generated",
    "../../../../models/issues_manager:bundle",
    "../../../../panels/network/forward:bundle",
    "../../../../ui/legacy:bundle",
    "../../../../ui/legacy/components/data_grid:bundle",
    "../../../components/buttons:bundle",
    "../../../kit:bundle",
    "../../../lit:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "cookie_table.ts"

  deps = [
    ":css_files",
    "../data_grid:css_files",
  ]

  ts_deps = [ ":cookie_table" ]

  visibility = [
    # IMPORTANT: Be careful when extending visibility of front_end/ui/legacy/*,
    # as the UI modules should only be used to actually build user interfaces,
    # and the business logic should never depend on the UI modules.
    ":*",
    "../../../../panels/application/*",
    "../../../../panels/network/*",
  ]

  visibility += devtools_ui_legacy_visibility
}

devtools_ui_module("unittests") {
  testonly = true
  split_compilation = true

  sources = [ "CookiesTable.test.ts" ]

  ts_deps = [
    ":bundle",
    "../..:bundle",
    "../../../../core/sdk:bundle",
    "../../../../models/bindings:bundle",
    "../../../../testing",
  ]
}
