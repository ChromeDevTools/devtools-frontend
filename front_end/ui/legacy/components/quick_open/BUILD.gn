import("../../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../../scripts/build/ninja/generate_css.gni")
import("../../../../../scripts/build/typescript/typescript.gni")
import("../../visibility.gni")

generate_css("css_files") {
  sources = [ "filteredListWidget.css" ]
}

devtools_ui_module("quick_open") {
  split_compilation = true
  sources = [
    "CommandMenu.ts",
    "FilteredListWidget.ts",
    "HelpQuickOpen.ts",
    "QuickOpen.ts",
  ]

  ts_deps = [
    "../../../../core/common:bundle",
    "../../../../core/host:bundle",
    "../../../../core/i18n:bundle",
    "../../../../core/platform:bundle",
    "../../../../core/text_utils:bundle",
    "../../../../models/geometry:bundle",
    "../../../../third_party/diff:bundle",
    "../../../../ui/components/text_prompt:bundle",
    "../../../../ui/legacy:bundle",
    "../../../components/highlighting:bundle",
    "../../../kit:bundle",
    "../../../lit:bundle",
    "../../../settings:bundle",
    "../../../visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "quick_open.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":quick_open" ]

  visibility = [
    # IMPORTANT: Be careful when extending visibility of front_end/ui/legacy/*,
    # as the UI modules should only be used to actually build user interfaces,
    # and the business logic should never depend on the UI modules.
    ":*",
    "../..:*",
    "../../../../panels/snippets/*",
    "../../../../panels/sources/*",
  ]

  visibility += devtools_ui_legacy_visibility
}

devtools_entrypoint("meta") {
  split_compilation = true
  entrypoint = "quick_open-meta.ts"

  ts_deps = [
    ":bundle",
    "../../../../core/i18n:bundle",
    "../../../../ui/legacy:bundle",
  ]

  visibility = [ "../../../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  testonly = true
  split_compilation = true

  sources = [
    "CommandMenu.test.ts",
    "FilteredListWidget.test.ts",
    "QuickOpen.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../..:bundle",
    "../../../../core/common:bundle",
    "../../../../core/i18n:bundle",
    "../../../../core/platform:bundle",
    "../../../../testing",
    "../../../settings:bundle",
  ]
}
