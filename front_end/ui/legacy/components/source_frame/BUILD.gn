import("../../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../../scripts/build/ninja/generate_css.gni")
import("../../../../../scripts/build/typescript/typescript.gni")
import("../../visibility.gni")

generate_css("css_files") {
  sources = [
    "fontView.css",
    "imageView.css",
    "jsonView.css",
    "resourceSourceFrame.css",
    "xmlTree.css",
    "xmlView.css",
  ]
}

devtools_ui_module("source_frame") {
  split_compilation = true
  sources = [
    "BinaryResourceViewFactory.ts",
    "FontView.ts",
    "ImageView.ts",
    "JSONView.ts",
    "PreviewFactory.ts",
    "ResourceSourceFrame.ts",
    "SourceFrame.ts",
    "StreamingContentHexView.ts",
    "XMLView.ts",
  ]

  ts_deps = [
    "../../../../core/common:bundle",
    "../../../../core/host:bundle",
    "../../../../core/i18n:bundle",
    "../../../../core/platform:bundle",
    "../../../../core/root:bundle",
    "../../../../core/sdk:bundle",
    "../../../../core/text_utils:bundle",
    "../../../../entrypoints/formatter_actions:bundle",
    "../../../../models/formatter:bundle",
    "../../../../models/workspace:bundle",
    "../../../../panels/linear_memory_inspector/components:bundle",
    "../../../../third_party/codemirror.next:bundle",
    "../../../../ui/components/highlighting:bundle",
    "../../../../ui/components/text_editor:bundle",
    "../../../../ui/legacy:bundle",
    "../../../../ui/legacy/components/object_ui:bundle",
    "../../../components/code_highlighter:bundle",
    "../../../components/dialogs:bundle",
    "../../../kit:bundle",
    "../../../lit:bundle",
    "../../../visual_logging:bundle",
  ]
}

devtools_entrypoint("bundle") {
  split_compilation = true
  entrypoint = "source_frame.ts"

  deps = [ ":css_files" ]

  ts_deps = [ ":source_frame" ]

  visibility = [
    # IMPORTANT: Be careful when extending visibility of front_end/ui/legacy/*,
    # as the UI modules should only be used to actually build user interfaces,
    # and the business logic should never depend on the UI modules.
    ":*",
    "../../../../panels/application/*",
    "../../../../panels/coverage/*",
    "../../../../panels/explain/*",
    "../../../../panels/media/*",
    "../../../../panels/network/*",
    "../../../../panels/protocol_monitor/*",
    "../../../../panels/sources/*",
    "../../../../testing/*",
    "../perf_ui/*",
  ]

  visibility += devtools_ui_legacy_visibility
}

devtools_entrypoint("meta") {
  split_compilation = true
  entrypoint = "source_frame-meta.ts"

  ts_deps = [
    "../../../../core/common:bundle",
    "../../../../core/i18n:bundle",
  ]

  visibility = [ "../../../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  testonly = true
  split_compilation = true

  sources = [
    "BinaryResourceViewFactory.test.ts",
    "FontView.test.ts",
    "JSONView.test.ts",
    "ResourceSourceFrame.test.ts",
    "SourceFrame.test.ts",
    "StreamingContentHexView.test.ts",
  ]

  ts_deps = [
    ":bundle",
    "../../../../core/common:bundle",
    "../../../../core/platform:bundle",
    "../../../../core/root:bundle",
    "../../../../core/text_utils:bundle",
    "../../../../panels/linear_memory_inspector/components:bundle",
    "../../../../testing",
    "../../../../third_party/codemirror.next:bundle",
    "../../../../ui/legacy:bundle",
    "../../../components/buttons:bundle",
    "../object_ui:bundle",
  ]
}
