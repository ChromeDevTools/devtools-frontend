import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../../visibility.gni")

devtools_ui_module("settings") {
  sources = [
    "InspectorMainSettings.ts",
    "MainSettings.ts",
    "SettingUIRegistration.ts",
  ]

  deps = [
    "../../core/common:bundle",
    "../../core/platform:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "settings.ts"

  deps = [ ":settings" ]

  visibility = [
    ":*",
    "../../entrypoints/*",
    "../../panels/*",
    "../../testing/*",
    "../components/*",
    "../legacy/*",
  ]

  visibility += devtools_visibility
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [ "SettingUIRegistration.test.ts" ]

  deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/i18n:bundle",
  ]
}
