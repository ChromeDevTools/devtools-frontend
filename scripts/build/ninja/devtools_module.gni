import("../../../scripts/build/ninja/vars.gni")
import("../../../scripts/build/typescript/typescript.gni")

template("devtools_base_module") {
  ts_library(target_name) {
    forward_variables_from(invoker, "*", [ "visibility" ])

    visibility += [ ":*" ]
  }
}

template("devtools_module") {
  devtools_base_module(target_name) {
    forward_variables_from(invoker, "*")
  }
}

template("devtools_api_test_module") {
  devtools_module(target_name) {
    testonly = true
    forward_variables_from(invoker,
                           "*",
                           [
                             "additional_type_definitions",
                             "testonly",
                             "ts_deps",
                           ])
    if (defined(invoker.additional_type_definitions)) {
      additional_type_definitions = invoker.additional_type_definitions
    } else {
      additional_type_definitions = []
    }
    additional_type_definitions +=
        [ devtools_location_prepend + "test/api/types.d.ts" ]

    if (defined(invoker.ts_deps)) {
      ts_deps = invoker.ts_deps
    } else {
      ts_deps = []
    }
    ts_deps += [ devtools_location_prepend + "test/api:test_interface_types" ]
  }
}

# A module that can run in any runtime we support. As such, it must only use
# features and APIs shared across all supported runtimes.
#
# To check for this we type-check both against browser and node runtime APIs.
template("devtools_foundation_module") {
  _node_type_check_target = target_name + "_node_typecheck"

  ts_type_check(_node_type_check_target) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "deps",
                             "ts_deps",
                             "visibility",
                           ])

    if (defined(invoker.ts_deps)) {
      ts_deps = invoker.ts_deps
    }
    if (defined(invoker.deps)) {
      deps = invoker.deps
    }

    es_target = "es2023"
    es_libs = []
    runs_in = "node_esm"
  }

  ts_library(target_name) {
    forward_variables_from(invoker, "*", [ "visibility" ])

    es_target = "es2023"
    es_libs = [
      "dom",
      "dom.iterable",
    ]

    visibility += [ ":*" ]

    public_deps += [ ":$_node_type_check_target" ]
  }
}

template("devtools_ui_module") {
  devtools_base_module(target_name) {
    forward_variables_from(invoker, "*")

    es_target = "esnext"
    es_libs = [
      "dom",
      "dom.iterable",
    ]
  }
}

foreach(module,
        [
          "devtools_api_test_module",
          "devtools_foundation_module",
          "devtools_module",
          "devtools_ui_module",
        ]) {
  set_defaults(module) {
    visibility = []
    data = []
    public_deps = []
  }
}
