import("//build/toolchain/kythe.gni")
import("//build_overrides/build.gni")

declare_args() {
  # Whether we bundle module entrypoints into a single file or not. The arg is
  # declared here and not in "devtools_entrypoint.gni" because various templates
  # need to read it, as it affects the "grd_files" metadata field.
  devtools_bundle = !enable_kythe_annotations

  # TODO(crbug.com/563174810): Whether to use DevTools' bundled PDL/JSON files
  # instead of the ToT files from the downstream Chromium tree when generating
  # CDP TypeScript types and metadata at build time.
  devtools_build_with_bundled_chromium_deps = true
}

assert(
    devtools_build_with_bundled_chromium_deps || build_with_chromium,
    "devtools_build_with_bundled_chromium_deps can only be false when build_with_chromium is true")

# Compute the DevTools source and gen root relative to this .gni file's own
# directory (scripts/build/ninja/). Because GN evaluates import()ed files in
# their own directory rather than the caller's, "../../../" always resolves to
# the DevTools root regardless of where the repo is mounted relative to `//`
# (standalone, in Chromium, or in embedders such as chrome-devtools-mcp).
devtools_location_prepend = get_path_info("../../../", "abspath")
devtools_gen_dir = get_path_info("../../../", "gen_dir")
