# A generated_ts() writes a .ts and a .d.ts into the gen dir, a ts_library()
# with `rootdir = target_gen_dir` compiles them there, and a module in the
# source tree imports both and bundles the result.
group("generated_ts") {
  deps = [ "front_end/property_checker:bundle" ]
}
