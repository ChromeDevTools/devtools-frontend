# A generator writes a .js and a .d.ts into the gen dir behind a group() with
# public_deps and public_inputs, a ts_library() depends on it via public_deps
# and imports it in .ts, and a devtools_entrypoint() bundles the result.
group("public_deps") {
  deps = [ "front_end/consumer:bundle" ]
}
