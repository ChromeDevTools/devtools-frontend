import("../../../../../../ninja/generated_ts.gni")

generated_ts("_generate_asset") {
  script = "generate_asset.py"
  outputs = [
    "$target_gen_dir/asset.js",
    "$target_gen_dir/asset.d.ts",
  ]
  args = [
    "--output-js",
    rebase_path("$target_gen_dir/asset.js", root_build_dir),
    "--output-dts",
    rebase_path("$target_gen_dir/asset.d.ts", root_build_dir),
  ]
}

group("generate_asset") {
  public_deps = [ ":_generate_asset" ]
  public_inputs = [
    "$target_gen_dir/asset.js",
    "$target_gen_dir/asset.d.ts",
  ]
  data = public_inputs
}
