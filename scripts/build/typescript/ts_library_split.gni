import("../ninja/vars.gni")
import("./typescript_vars.gni")

# Architecture Overview:
# ======================
# ts_library_split decouples declaration generation from type-checking and
# JavaScript emission into 4 discrete sub-targets per library:
#
#   1) ${target_name}-dts:
#      Fast, parallel declaration emit (.d.ts) using:
#      `tsc --declaration --emitDeclarationOnly --isolatedDeclarations --noCheck --noResolve`
#      Zero dependency on upstream targets.
#
#   2) ${target_name}_tsconfig_ref:
#      Generated reference descriptor (`*-tsconfig.ref.json`) consumed by
#      downstream tsconfigs.
#
#   3) ${target_name}_tsconfig:
#      Generated compilation descriptor (`*-tsconfig.json`) configured with
#      `disableSourceOfProjectReferenceRedirect = true` pointing to upstream
#      `*-tsconfig.ref.json` project references.
#
#   4) ${target_name}_checked:
#      Full type-checking and runtime JavaScript transpilation (.js, .js.map)
#      using `tsc -p *-tsconfig.json`.
#
#   Primary group(${target_name}):
#      Assembles compile-time `public_deps` (.d.ts + tsconfig.ref) and
#      runtime `data_deps` (JS).
#
# Dependency Graph Example:
# -------------------------
# Suppose `module_b` depends on `module_a` (`ts_deps = [ "../a:module_a" ]`):
#
#   +-----------------------------------------------------------------------+
#   |                              module_a                                 |
#   |                                                                       |
#   |  [1] module_a-dts (Action)                                            |
#   |      sources -> module_a/*.d.ts (via --isolatedDeclarations)          |
#   |         ^                                                             |
#   |         |                                                             |
#   |  [2] module_a_tsconfig_ref (generated_file)                           |
#   |      -> module_a-tsconfig.ref.json                                    |
#   |         ^                                                             |
#   |         | (public_deps)                                               |
#   |  [group("module_a")] --------------------------------+                |
#   |         | (data_deps)                                |                |
#   |         v                                            |                |
#   |  [3] module_a_tsconfig (generated_file)              | (ts_deps)      |
#   |      -> module_a-tsconfig.json                       |                |
#   |         ^                                            |                |
#   |         |                                            |                |
#   |  [4] module_a_checked (Action)                       |                |
#   |      module_a/*.ts -> module_a/*.js                  |                |
#   +------------------------------------------------------|----------------+
#                                                          |
#                                                          v
#   +-----------------------------------------------------------------------+
#   |                              module_b                                 |
#   |                                                                       |
#   |  [1] module_b-dts (Action)                                            |
#   |      sources -> module_b/*.d.ts (no wait for module_a!)               |
#   |                                                                       |
#   |  [2] module_b_tsconfig_ref (generated_file)                           |
#   |      -> module_b-tsconfig.ref.json                                    |
#   |                                                                       |
#   |  [3] module_b_tsconfig (generated_file)                               |
#   |      references = [ "../a/module_a-tsconfig.ref.json" ]               |
#   |         ^                                                             |
#   |         |                                                             |
#   |  [4] module_b_checked (Action: tsc -p module_b-tsconfig.json)         |
#   |      deps = [ :module_b-dts, :module_b_tsconfig, "../a:module_a" ]    |
#   |      Resolves module_a types from module_a/*.d.ts                     |
#   |                                                                       |
#   |  [group("module_b")]                                                  |
#   |      public_deps = [ :module_b-dts, :module_b_tsconfig_ref,           |
#   |                      "../a:module_a" ]                                |
#   |      data_deps   = [ :module_b_checked ]                              |
#   +-----------------------------------------------------------------------+
#
# Compilation Flow & Ninja Restat:
# --------------------------------
# 1. (Parallel Emit)  :module_a-dts and :module_b-dts execute concurrently
#    without blocking on upstream JS compilation.
# 2. (Type-Checking)  :module_b_checked waits for :module_a-dts (via public_deps
#    of module_a) and consumes `module_a/*.d.ts`.
# 3. (Pruned Cascades) If module_a implementation changes without modifying
#    public signatures, `run_with_restat.py` keeps the .d.ts mtime unchanged,
#    causing Ninja to prune recompilation of :module_b_checked.

# Defines a TypeScript library target using tsc v7+.
template("ts_library_split") {
  assert(defined(invoker.sources),
         "You must specify 'sources' for $target_name")

  _rootdir = "."
  if (defined(invoker.rootdir)) {
    _rootdir = invoker.rootdir
  }
  _tsc_dir = string_replace(target_gen_dir, root_gen_dir, "$root_out_dir/tsc")

  _tsconfig_name = target_name
  if (defined(invoker.tsconfig_name)) {
    _tsconfig_name = invoker.tsconfig_name
  }

  _dts_target = "${target_name}-dts"
  _tsconfig_ref_target = "${target_name}_tsconfig_ref"
  _tsconfig_ref_file = "$_tsc_dir/$_tsconfig_name-tsconfig.ref.json"
  _tsconfig_target = "${target_name}_tsconfig"
  _tsconfig_file = "$_tsc_dir/$_tsconfig_name-tsconfig.json"
  _js_target = "${target_name}_checked"

  _all_sources = invoker.sources
  if (defined(invoker.additional_type_definitions)) {
    _all_sources += invoker.additional_type_definitions
  }

  _ts_references = []
  _ts_deps = []
  if (defined(invoker.ts_deps)) {
    _ts_deps = invoker.ts_deps
    foreach(dep, _ts_deps) {
      _dep_name = get_label_info(dep, "name")
      _dep_gen_dir = get_label_info(dep, "target_gen_dir")
      _dep_tsc_dir =
          string_replace(_dep_gen_dir, root_gen_dir, "$root_out_dir/tsc")
      _ts_references += [
        {
          path = rebase_path("$_dep_tsc_dir/$_dep_name-tsconfig.ref.json",
                             _tsc_dir)
        },
      ]
    }
  }

  _non_ts_deps = []
  if (defined(invoker.deps)) {
    _non_ts_deps = invoker.deps
  }

  _es_target = "ES2023"
  if (defined(invoker.es_target)) {
    _es_target = invoker.es_target
  }

  _module = "esnext"
  _module_resolution = "bundler"
  if (defined(invoker.runs_in) && invoker.runs_in == "node_cjs") {
    _module = "nodenext"
    _module_resolution = "nodenext"
  }

  # This is a small optimization and concession that for unbundled builds, we
  # emit the JS and source map files from sub-target 3 directly into the
  # `out/<config>/gen` directory. This safes us a copy action for each JS/source
  # map pair. We might turn this into an option on ts_library_split directly so
  # this rule becomes more generic.
  if (devtools_bundle) {
    _outdir = "."
  } else {
    _outdir = rebase_path(target_gen_dir, _tsc_dir)
  }

  _compiler_options = {
    target = _es_target
    module = _module
    moduleResolution = _module_resolution
    strict = true
    skipLibCheck = true
    allowJs = true
    checkJs = true
    forceConsistentCasingInFileNames = true
    inlineSources = true
    noEmitOnError = true
    sourceMap = true
    declaration = false
    composite = false
    incremental = false
    disableSourceOfProjectReferenceRedirect = true
    rootDir = rebase_path(_rootdir, _tsc_dir)
    outDir = _outdir
  }

  if (defined(invoker.es_libs)) {
    _compiler_options.lib = invoker.es_libs
  }

  # Compute output file paths (tsc does not emit for .d.ts inputs)
  _dts_outputs = []
  _js_outputs = []
  foreach(src, invoker.sources) {
    _ext = get_path_info(src, "extension")
    _name = get_path_info(src, "name")
    _rel_name = rebase_path(src, _rootdir)
    _rel_dir = get_path_info(_rel_name, "dir")
    if (_rel_dir == "" || _rel_dir == ".") {
      _file_base = get_path_info(_rel_name, "name")
    } else {
      _file_base = _rel_dir + "/" + get_path_info(_rel_name, "name")
    }

    if (!(_ext == "ts" && get_path_info(_name, "extension") == "d")) {
      _dts_outputs += [ "$_tsc_dir/$_file_base.d.ts" ]
      if (devtools_bundle) {
        _js_outputs += [
          "$_tsc_dir/$_file_base.js",
          "$_tsc_dir/$_file_base.js.map",
        ]
      } else {
        _js_outputs += [
          "$target_gen_dir/$_file_base.js",
          "$target_gen_dir/$_file_base.js.map",
        ]
      }
    }
  }

  # Sub-target 1: Type definitions (.d.ts only) via direct tsc
  action(_dts_target) {
    script = devtools_location_prepend + "scripts/build/run_with_restat.py"

    inputs = typescript_base_inputs + _all_sources

    deps = _non_ts_deps

    outputs = _dts_outputs

    # Expose ts files to dependent targets.
    public_inputs = filter_include(_all_sources,
                                   [
                                     "*.ts",
                                     "*.d.ts",
                                   ])

    response_file_contents =
        rebase_path(_dts_outputs, root_build_dir) + [ "--" ] + [
          rebase_path(tsc_binary, root_build_dir),
          "--ignoreConfig",
          "--declaration",
          "--emitDeclarationOnly",
          "--isolatedDeclarations",
          "--noCheck",
          "--noResolve",
          "--outDir",
          rebase_path(_tsc_dir, root_build_dir),
          "--rootDir",
          rebase_path(_rootdir, root_build_dir),
        ] + rebase_path(_all_sources, root_build_dir)

    args = [ "@{{response_file_name}}" ]

    if (defined(invoker.testonly)) {
      testonly = invoker.testonly
    }
    if (defined(invoker.visibility)) {
      visibility = invoker.visibility
    }
  }

  # Sub-target 2: Generate tsconfig.ref.json for downstream consumers.
  # Downstream dependents point to this tsconfig.ref.json as a project
  # "reference" in the dependent's tsconfig used for type-checking.
  generated_file(_tsconfig_ref_target) {
    outputs = [ _tsconfig_ref_file ]
    output_conversion = "json"
    contents = {
      compilerOptions = {
        composite = true
        declaration = true
        emitDeclarationOnly = true
        skipLibCheck = true
        rootDir = rebase_path(_rootdir, _tsc_dir)
        outDir = "."
        declarationDir = "."
      }
      files = rebase_path(_all_sources, _tsc_dir)
      references = _ts_references
    }
    if (defined(invoker.testonly)) {
      testonly = invoker.testonly
    }
  }

  # Sub-target 3: Generate tsconfig.json used by sub-target 4 for
  # actual type-checking and JS transpilation.
  generated_file(_tsconfig_target) {
    outputs = [ _tsconfig_file ]
    output_conversion = "json"
    contents = {
      compilerOptions = _compiler_options
      files = rebase_path(_all_sources, _tsc_dir)
      references = _ts_references
    }
    if (defined(invoker.testonly)) {
      testonly = invoker.testonly
    }
  }

  # Sub-target 4: JS Transpilation + Type-checking via direct tsc
  action(_js_target) {
    script = devtools_location_prepend + "scripts/build/run_with_restat.py"

    inputs = typescript_base_inputs + _all_sources + [ _tsconfig_file ]

    deps = [
             ":$_dts_target",
             ":$_tsconfig_target",
           ] + _ts_deps + _non_ts_deps

    outputs = _js_outputs

    response_file_contents =
        rebase_path(_js_outputs, root_build_dir) + [ "--" ] + [
          rebase_path(tsc_binary, root_build_dir),
          "-p",
          rebase_path(_tsconfig_file, root_build_dir),
        ]

    args = [ "@{{response_file_name}}" ]

    if (defined(invoker.testonly)) {
      testonly = invoker.testonly
    }
  }

  # Primary group target
  group(target_name) {
    public_deps = [
                    ":$_dts_target",
                    ":$_tsconfig_ref_target",
                  ] + _ts_deps

    data = _js_outputs
    if (defined(invoker.data)) {
      data += invoker.data
    }

    data_deps = [ ":$_js_target" ]
    if (defined(invoker.deps)) {
      data_deps += invoker.deps
    }
    if (defined(invoker.data_deps)) {
      data_deps += invoker.data_deps
    }

    metadata = {
      typescript_files = rebase_path(invoker.sources, root_build_dir)
      tests = filter_include(_js_outputs,
                             [
                               "*.test.js",
                               "*_test.js",
                               "*.test.api.js",
                             ])
    }

    if (!devtools_bundle) {
      metadata.grd_files = filter_include(_js_outputs, [ "*.js" ])
    }

    if (defined(invoker.testonly)) {
      testonly = invoker.testonly
    }
    if (defined(invoker.visibility)) {
      visibility = invoker.visibility
    }
  }
}

set_defaults("ts_library_split") {
  visibility = [ "*" ]
}
