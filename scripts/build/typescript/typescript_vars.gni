import("//build/toolchain/rbe.gni")

if (host_os == "linux") {
  tsc_binary = "//third_party/typescript/linux-amd64/src/lib/tsc"
} else if (host_os == "win") {
  tsc_binary = "//third_party/typescript/windows-amd64/src/lib/tsc.exe"
} else if (host_os == "mac") {
  if (host_cpu == "arm64") {
    tsc_binary = "//third_party/typescript/mac-arm64/src/lib/tsc"
  } else {
    tsc_binary = "//third_party/typescript/mac-amd64/src/lib/tsc"
  }
}

