{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": true,
    "composite": false,
    "declaration": false,
    "disableSourceOfProjectReferenceRedirect": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": false,
    "inlineSources": true,
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023",
      "ES2024.Promise",
      "ESNext.Iterator",
      "ESNext.Collection",
      "ESNext.Array"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "outDir": ".",
    "preserveConstEnums": true,
    "rootDir": "../../../../../scripts/component_docs",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2023",
    "typeRoots": [
      "../../../../../node_modules/@types",
      "../../../../../node_modules"
    ],
    "types": [
      "mocha"
    ],
    "useUnknownInCatchVariables": false
  },
  "files": [
    "../../../../../scripts/component_docs/docs_environment.ts",
    "../../../../../scripts/component_docs/toggle_dark_mode.ts",
    "../../../../../scripts/component_docs/toggle_fonts.ts",
    "../../../../../front_end/legacy/legacy-defs.d.ts",
    "../../../../../front_end/global_typings/global_defs.d.ts",
    "../../../../../node_modules/@types/filesystem/index.d.ts",
    "../../../../../node_modules/@types/filewriter/index.d.ts"
  ],
  "references": [
    {
      "path": "../../front_end/core/common/bundle-tsconfig.ref.json"
    },
    {
      "path": "../../front_end/testing/testing-tsconfig.ref.json"
    },
    {
      "path": "../../front_end/ui/legacy/theme_support/bundle-tsconfig.ref.json"
    }
  ]
}