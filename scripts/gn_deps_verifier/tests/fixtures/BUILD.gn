import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

_helper_sources = [ "Helper.ts" ]

generate_css("css_files") {
  sources = [ "animationTimeline.css" ]
}

devtools_ui_module("animation") {
  sources = [
    "AnimationGroupPreviewUI.ts",
    "AnimationTimeline.ts",
    "AnimationUI.ts",
  ]

  deps = [
    "../../core/common:bundle",
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/platform:bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../models/geometry:bundle",
    "../../ui/components/buttons:bundle",
    "../../ui/legacy:bundle",
    "../../ui/legacy/components/inline_editor:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
    "../common:bundle",
  ]
}

devtools_ui_module("helpers") {
  sources = _helper_sources + [ "Extra.ts" ]

  deps = [ ":bundle" ]
}

devtools_ui_module("filtered") {
  sources = _helper_sources - [ "Excluded.ts" ]

  deps = [ ":bundle" ]
}

devtools_entrypoint("bundle") {
  entrypoint = "animation.ts"

  deps = [
    ":animation",
    ":css_files",
  ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "animation-meta.ts"

  deps = [
    ":bundle",
    "../../core/common:bundle",
    "../../core/i18n:bundle",
    "../../core/sdk:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [ "../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [ "AnimationTimeline.test.ts" ]

  deps = [
    ":bundle",
    "../../core/sdk:bundle",
    "../../generated",
    "../../testing",
  ]
}

devtools_foundation_module("platform") {
  sources = [ "HostRuntime.ts" ]

  ts_deps = [ "./api:bundle" ]

  public_deps = [ ":typecheck" ]
}

custom_target("complex_assignments") {
  _local_files = [
    "local1.ts",
    "local2.ts",
    "excluded.ts",
  ]
  sources = _local_files
  sources -= [ "excluded.ts" ]
  inputs = [ "input1.json" ]
  entrypoint = "main.ts"
  deps = [ ":dep1" ]
  deps += [ ":dep2" ]
}
