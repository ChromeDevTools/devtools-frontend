{
  "extends": "../config/typescript/tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "target": "ESNext",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "isolatedDeclarations": false,
    "noImplicitAny": false,
    "erasableSyntaxOnly": true
  }
}
