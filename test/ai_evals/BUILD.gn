import("../../scripts/build/ninja/copy.gni")
import("../../scripts/build/typescript/typescript.gni")

group("ai_evals") {
  testonly = true
  deps = [
    ":eval_tests",
    ":harness_library",
    ":test_inputs",
    "network",
    "performance",
  ]
}

node_ts_library("eval_tests") {
  sources = [ "ai_smoke.test.ts" ]
  ts_deps = [
    ":harness_library",
    "../../front_end/core/sdk:bundle",
    "../../front_end/panels/ai_assistance:bundle",
    "../e2e/helpers",
    "helpers",
  ]
}

node_ts_library("harness_library") {
  sources = [
    "ai-eval-state-provider.ts",
    "mocha-interface.ts",
    "mocha_hooks.ts",
    "run-mocha.ts",
  ]
  ts_deps = [
    "../../front_end/panels/ai_assistance:bundle",
    "../conductor:implementation",
    "../e2e/conductor:implementation",
    "../e2e/shared",
    "../shared",
    "helpers",
    "report",
  ]
}

generated_file("test_inputs") {
  testonly = true
  outputs = [ "$target_gen_dir/tests.txt" ]
  data_keys = [ "tests" ]
  rebase = target_gen_dir

  deps = [
    ":eval_tests",
    "performance",
  ]
}
