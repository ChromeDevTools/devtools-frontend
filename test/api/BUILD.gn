import("../../scripts/build/ninja/devtools_pre_built.gni")
import("../../scripts/build/typescript/typescript.gni")

# We expose types.d.ts as a devtools_pre_built library so that the
# devtools_api_test_module template can inject it as a ts_dep into API test
# targets. Because types.d.ts imports from Foundation and Conductor, this
# establishes a Ninja DAG dependency edge ensuring API tests are re-typechecked
# whenever Foundation or Conductor change.
#
# Additionally, this target acts as an architectural bridge: core/ and models/
# cannot depend directly on Foundation due to GN visibility restrictions, but
# test/api/* is explicitly allowlisted by Foundation.
devtools_pre_built("test_interface_types") {
  testonly = true
  sources_are_release = false
  sources = [ "types.d.ts" ]
  ts_deps = [
    "../../front_end/foundation:bundle",
    "../conductor:implementation",
  ]
}

node_ts_library("api") {
  additional_type_definitions = [ "types.d.ts" ]

  sources = [
    "TargetUniverse.ts",
    "api-state-provider.ts",
    "mocha-interface.ts",
    "mocha_hooks.ts",
    "run-mocha.ts",
  ]

  ts_deps = [
    "../../front_end/core/common:bundle",
    "../../front_end/core/host:bundle",
    "../../front_end/core/protocol_client:bundle",
    "../../front_end/core/protocol_client:puppeteer_devtools_connection",
    "../../front_end/core/root:bundle",
    "../../front_end/core/sdk:bundle",
    "../../front_end/foundation:bundle",
    "../conductor:implementation",
    "../e2e/conductor:implementation",
    "../shared",
  ]
}
