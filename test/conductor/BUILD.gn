import("../../scripts/build/ninja/devtools_pre_built.gni")
import("../../scripts/build/typescript/typescript.gni")

group("conductor") {
  deps = [
    ":implementation",
    "../../scripts/hosted_mode",
  ]
}

devtools_pre_built("expectations_parser") {
  sources_are_release = false
  sources = [
    "test_expectations_parser.d.ts",
    "test_expectations_parser.js",
  ]
}

node_ts_library("implementation") {
  testonly = false
  inputs = typescript_yargs_types_inputs + typescript_diff_types_inputs

  # The conductor API exposes Mocha and Puppeteer types, so dependents read
  # them when type checking.
  public_inputs =
      typescript_test_types_inputs + typescript_puppeteer_types_inputs

  deps = [ "../:build_config" ]
  data = [ "../../scripts/deps/set_lpac_acls.py" ]
  ts_deps = [
    ":expectations_parser",
    "../../front_end/testing:test_id_generation",
  ]

  sources = [
    "async-scope.ts",
    "commandline.ts",
    "custom-query-handlers.ts",
    "diff-utils.ts",
    "events.ts",
    "inspected_page.ts",
    "karma-resultsdb-reporter.ts",
    "mocha-interface-helpers.ts",
    "mocha-interface.ts",
    "paths.ts",
    "platform.ts",
    "resultsdb.ts",
    "screenshot-error.ts",
    "sharding.ts",
    "test_config.ts",
    "test_expectations.ts",
    "test_server.ts",
  ]
}
