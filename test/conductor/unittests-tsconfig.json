{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "composite": false,
    "declaration": false,
    "disableSourceOfProjectReferenceRedirect": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": false,
    "inlineSources": true,
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023",
      "ES2024.Promise",
      "ESNext.Iterator",
      "ESNext.Collection",
      "ESNext.Array"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "outDir": ".",
    "preserveConstEnums": true,
    "rootDir": "../../../../../test/conductor",
    "rootDirs": [
      "../../../../../",
      "../../"
    ],
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2023",
    "typeRoots": [
      "../../../../../node_modules/@types",
      "../../../../../node_modules"
    ],
    "types": [
      "node",
      "undici-types"
    ],
    "useUnknownInCatchVariables": false
  },
  "files": [
    "../../../../../test/conductor/paths.test.ts",
    "../../../../../test/conductor/test_config.test.ts",
    "../../../../../front_end/legacy/legacy-defs.d.ts",
    "../../../../../front_end/global_typings/global_defs.d.ts",
    "../../../../../node_modules/@types/filesystem/index.d.ts",
    "../../../../../node_modules/@types/filewriter/index.d.ts"
  ],
  "references": [
    {
      "path": "core-tsconfig.ref.json"
    }
  ]
}