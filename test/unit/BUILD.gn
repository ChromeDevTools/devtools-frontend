import("../../scripts/build/ninja/copy.gni")
import("../../scripts/build/ninja/script_test.gni")
import("../../scripts/build/ninja/vars.gni")
import("../../scripts/build/typescript/typescript.gni")

if (!devtools_build_with_bundled_chromium_deps) {
  import("//build/config/cast.gni")
  import("//build/config/chromeos/args.gni")
}

ts_library("browser-globals") {
  testonly = true
  sources = [ "browser-globals.ts" ]
}

ts_library("mocha-interface") {
  testonly = true
  sources = [ "mocha-interface.ts" ]
  ts_deps = [ ":browser-globals" ]
}

ts_library("mocha-adapter-browser") {
  testonly = true
  sources = [ "mocha-adapter-browser.ts" ]
  ts_deps = [
    ":browser-globals",
    ":mocha-interface",
    "../../front_end/testing:mocha_helpers",
  ]
}

node_ts_library("karma") {
  sources = [ "karma.conf.ts" ]
  ts_deps = [
    "../../front_end/testing:test_id_generation",
    "../conductor:implementation",
    "../shared",
  ]
  data_deps = [
    ":context",
    ":mocha-adapter-browser",
    ":mocha-interface",
    "../../front_end/testing",
  ]
}

node_ts_library("mocha") {
  sources = [
    "mocha-hooks.ts",
    "run-mocha.ts",
  ]
  ts_deps = [
    "../conductor:implementation",
    "../shared",
  ]
}

copy_to_gen("context") {
  sources = [
    "context.html",
    "debug.html",
  ]
}

node_script_test("devtools_unit_tests") {
  script = devtools_location_prepend + "node_modules/karma/bin/karma"

  _rebased_karma_conf =
      rebase_path("$target_gen_dir/karma.conf.js", root_build_dir)
  args = [
    "start",
    "@WrappedPath(${_rebased_karma_conf})",
  ]

  data = [
    devtools_location_prepend + "test/goldens/linux/",
    devtools_location_prepend + "third_party/image_diff/",
  ]

  data_deps = [
    ":karma",
    "../../front_end:test_inputs",
    "../../front_end:unittests",
    "../../inspector_overlay:test_inputs",
    "../../inspector_overlay:unittests",
    "../harness",
  ]

  if (!devtools_build_with_bundled_chromium_deps) {
    if (!is_ios && !is_android && !is_castos && !is_fuchsia &&
        !is_chromeos_device) {
      data_deps += [ "//chrome" ]
    }
  } else if (!build_with_chromium) {
    data += [ devtools_location_prepend + "third_party/chrome/" ]
  }
}

node_script_test("devtools_node_unit_tests") {
  script = "$target_gen_dir/run-mocha.js"

  data_deps = [
    ":mocha",
    "../../front_end:foundation_test_inputs",
    "../../front_end:foundation_unittests",
    "../../mcp:foundation_unittests",
    "../../mcp:test_inputs",
    "../harness",
  ]
}
