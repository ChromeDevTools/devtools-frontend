{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": true,
    "composite": false,
    "declaration": false,
    "disableSourceOfProjectReferenceRedirect": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": false,
    "inlineSources": true,
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023",
      "ES2024.Promise",
      "ESNext.Iterator",
      "ESNext.Collection",
      "ESNext.Array"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "outDir": ".",
    "preserveConstEnums": true,
    "rootDir": "../../../../../test/unit",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2023",
    "typeRoots": [
      "../../../../../node_modules/@types",
      "../../../../../node_modules"
    ],
    "types": [
      "mocha"
    ],
    "useUnknownInCatchVariables": false
  },
  "files": [
    "../../../../../test/unit/mocha-adapter-browser.ts",
    "../../../../../front_end/legacy/legacy-defs.d.ts",
    "../../../../../front_end/global_typings/global_defs.d.ts",
    "../../../../../node_modules/@types/filesystem/index.d.ts",
    "../../../../../node_modules/@types/filewriter/index.d.ts"
  ],
  "references": [
    {
      "path": "browser-globals-tsconfig.ref.json"
    },
    {
      "path": "mocha-interface-tsconfig.ref.json"
    },
    {
      "path": "../../front_end/testing/mocha_helpers-tsconfig.ref.json"
    }
  ]
}